#!/usr/bin/env bash
set -u

# Keep the live desktop awake while it is being evaluated in a VM.
xset s off 2>/dev/null || true
xset -dpms 2>/dev/null || true
xsetroot -solid '#08131c' 2>/dev/null || true

# VirtualBox integration. These commands are harmless on non-VirtualBox hosts.
VBoxClient --vmsvga >/tmp/josh-os-vbox-vmsvga.log 2>&1 &
VBoxClient --clipboard >/tmp/josh-os-vbox-clipboard.log 2>&1 &

# Openbox is only the Stage 0 host window manager. The Josh OS shell fills the
# display; the real Stage 1 window system remains the planned Wayland compositor.
openbox >/tmp/josh-os-openbox.log 2>&1 &
sleep 0.5

url='file:///opt/josh-os/shell/index.html'

# If Chromium exits accidentally, bring the shell back. Ctrl+Alt+F2 still gives
# a Linux TTY for debugging the live image.
while true; do
  chromium \
    --kiosk \
    --ozone-platform=x11 \
    --disable-gpu \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-infobars \
    --disable-translate \
    --password-store=basic \
    --user-data-dir=/home/josh/.config/chromium-josh-os \
    "$url" >/tmp/josh-os-chromium.log 2>&1
  sleep 1
done
