#!/usr/bin/env bash
set -u

serial=/dev/ttyS0
emit() {
  local message="$1"
  logger -t josh-network-probe "$message"
  if [[ -w "$serial" ]]; then
    printf '%s\r\n' "$message" >"$serial"
  fi
}

ready=0
for _ in $(seq 1 90); do
  nm_state="$(nmcli -t -f STATE general 2>/dev/null || true)"
  ntp_state="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
  if [[ "$nm_state" == connected* ]] && [[ "$ntp_state" == yes ]]; then
    ready=1
    break
  fi
  sleep 1
done

if (( ! ready )); then
  emit "JOSHOS_NETWORK_READY_FAIL preconditions"
  exit 1
fi

if /usr/local/bin/josh-network-check >/tmp/josh-network-check.log 2>&1; then
  emit "JOSHOS_NETWORK_READY"
  exit 0
fi

emit "JOSHOS_NETWORK_READY_FAIL checks"
while IFS= read -r line; do
  emit "JOSHOS_NETWORK_DIAG $line"
done </tmp/josh-network-check.log
exit 1
